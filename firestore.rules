rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só o Vitor e a Ana Carina podem ler e escrever.
    function membro() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['vitordiasleite@gmail.com', 'carinalestre@gmail.com'];
    }
    match /{col}/{id} {
      allow read, write: if membro() && col in ['mov', 'fixos', 'metas', 'cfg', 'talao'];
    }
  }
}
